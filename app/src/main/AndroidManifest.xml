<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Bluetooth is the actual bulk-data transport; NFC only carries the pairing handshake. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE scan/advertise are how a device's real Bluetooth address is discovered post-handshake
         (see transport/ble/BlePairingAdvertiser.kt); neverForLocation asserts we only match a
         session token and never use scan results to infer location, so API 31+ doesn't also
         require a location permission for this. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Below API 31, BLE scanning requires location permission regardless of intent — an
         Android platform quirk, not something neverForLocation can opt out of pre-31. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />

    <!-- Needed to prompt the user to install a newer APK pulled from a peer device. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TaskShareApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.TaskShare"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TaskShare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Host Card Emulation service: lets this device act as the "tag" side of
             the NFC handshake when the other phone taps it in reader mode.
             See nfc/NfcHandshakeHostService.kt. -->
        <service
            android:name=".nfc.NfcHandshakeHostService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
